#!/bin/bash
set -euo pipefail

# TRAP: Print error line if crash happens
trap 'echo "🚨 SCRIPT CRASHED on line $LINENO" >&2' ERR

# --- CONFIGURATION ---
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
export CIVITAI_TOKEN="${CIVITAI_TOKEN}"

if [ -z "$CIVITAI_TOKEN" ]; then
  echo "ERROR: CivitAI token not found!"
  exit 1
fi

# --- CRITICAL PATH SEPARATION ---
# APP_DIR: Where the code runs (Ephemeral, fast). Extensions go here.
APP_DIR="/app/stable-diffusion-webui-forge"
# STORAGE_DIR: Where the models live (Persistent). Heavy files go here.
STORAGE_DIR="/workspace/stable-diffusion-webui-forge"

# Define specific subdirectories
EXT_DIR="$APP_DIR/extensions"
MODEL_DIR="$STORAGE_DIR/models/Stable-diffusion"
LORA_DIR="$STORAGE_DIR/models/Lora"

# Ensure directories exist
mkdir -p "$EXT_DIR"
mkdir -p "$MODEL_DIR"
mkdir -p "$LORA_DIR"

# Function to sanitize filenames
sanitize() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '_' | tr -cd '[:alnum:]._-'
}

# --- HELPER FUNCTIONS (unchanged logic, updated paths) ---

download_file_with_retries() {
  local url=$1
  local output_path=$2
  local max_retries=5
  local retry_count=0
  
  mkdir -p "$(dirname "$output_path")"
  
  while [ $retry_count -lt $max_retries ]; do
    if curl -fL -A "$USER_AGENT" -o "$output_path" "$url"; then
      echo "Successfully downloaded $output_path"
      return 0
    else
      echo "WARNING: Failed to download $url. Retrying..."
      rm -f "$output_path"
      retry_count=$((retry_count + 1))
      sleep 5
    fi
  done
  echo "ERROR: Skipping $output_path after failures."
  return 1
}

# INSTALL EXTENSION DIRECTLY TO APP DIR
install_extension() {
  local repo_url=$1
  local repo_name=$(basename "$repo_url" .git)
  local target_dir="$EXT_DIR/$repo_name"
  
  if [ ! -d "$target_dir" ]; then
    echo "Installing extension: $repo_name to $target_dir"
    git clone "$repo_url" "$target_dir" || echo "WARNING: Failed to clone $repo_name"
  else
    echo "Extension already installed: $repo_name"
  fi
}

download_civit_model() {
  local model_version_id=$1
  local target_dir=$2
  local max_download_retries=5
  local download_retry_count=0
  local download_success=false
  
  mkdir -p "$target_dir"
  
  while [ $download_retry_count -lt $max_download_retries ] && [ "$download_success" = false ]; do
    echo "Processing Model ID $model_version_id..."

    # Try Metadata API
    local api_response
    set +e 
    api_response=$(curl -s -A "$USER_AGENT" -H "Authorization: Bearer $CIVITAI_TOKEN" "https://civitai.com/api/v1/model-versions/$model_version_id")
    set -e
    
    if echo "$api_response" | jq -e .model.name >/dev/null 2>&1; then
      local model_name=$(echo "$api_response" | jq -r '.model.name // "unknown"')
      local version_name=$(echo "$api_response" | jq -r '.name // "unknown"')
      local primary_file=$(echo "$api_response" | jq -r '.files[] | select(.primary == true) | .name')
      local download_url=$(echo "$api_response" | jq -r '.files[] | select(.primary == true) | .downloadUrl')
      
      if [[ -z "$download_url" || "$download_url" == "null" ]]; then
          echo "WARNING: No download URL found in metadata."
      else
          local safe_name=$(sanitize "$model_name")
          local safe_ver=$(sanitize "$version_name")
          local filename="${safe_name}_${safe_ver}.${primary_file##*.}"
          
          # Check if file already exists in persistent storage
          if [ -f "$target_dir/$filename" ]; then
             echo "File $filename already exists. Skipping download."
             download_success=true
          else
             echo "Downloading $filename..."
             if curl -L -A "$USER_AGENT" -H "Authorization: Bearer $CIVITAI_TOKEN" -o "$target_dir/$filename" "$download_url"; then
               download_success=true
             fi
          fi
      fi
    fi

    # Direct Fallback
    if [ "$download_success" = false ]; then
       echo "Attempting Direct Download for ID $model_version_id..."
       pushd "$target_dir" > /dev/null
       set +e
       if curl -L -J -O -A "$USER_AGENT" -H "Authorization: Bearer $CIVITAI_TOKEN" "https://civitai.com/api/download/models/$model_version_id"; then
         download_success=true
       fi
       set -e
       popd > /dev/null
    fi

    if [ "$download_success" = true ]; then
       local downloaded_file=$(ls -t "$target_dir" | head -n1)
       if file "$target_dir/$downloaded_file" | grep -q "HTML"; then
          rm -f "$target_dir/$downloaded_file"
          download_success=false
          sleep 5
       else
          echo "SUCCESS: $downloaded_file"
          return 0
       fi
    fi
    download_retry_count=$((download_retry_count + 1))
  done
  return 1 
}

ensure_civitai_asset_installed() {
  if download_civit_model "$1" "$2"; then return 0; else return 0; fi
}

# ====================================================================================
#  EXECUTION
# ====================================================================================

echo "--- 1. INSTALLING CONFIG & EXTENSIONS (To App Dir) ---"
# Download UI Config directly to the running app folder
download_file_with_retries "https://raw.githubusercontent.com/tamnhucanh/vast-provisioning-scripts/refs/heads/main/ui-config.json" "$APP_DIR/ui-config.json" || true

# Install Extensions directly to the running app folder
install_extension "https://github.com/Mikubill/sd-webui-controlnet.git" 
install_extension "https://github.com/camenduru/sd-webui-additional-networks.git" 
install_extension "https://github.com/AlUlkesh/stable-diffusion-webui-images-browser.git" 
install_extension "https://github.com/DominikDoom/a1111-sd-webui-tagcomplete.git" 
install_extension "https://github.com/adieyal/sd-dynamic-prompts.git" 
install_extension "https://github.com/Bing-su/adetailer.git" 
install_extension "https://github.com/BlafKing/sd-civitai-browser-plus.git" 

echo "--- 2. DOWNLOADING MODELS (To Workspace Storage) ---"
# 2. ControlNet Models (To Workspace, then we rely on --controlnet-dir argument if needed, 
# but usually it's better to keep these in app dir for speed if they are small. 
# For now, putting them in APP DIR since they are critical dependencies)
mkdir -p "$EXT_DIR/sd-webui-controlnet/models"
download_file_with_retries "https://huggingface.co/lllyasviel/ControlNet-v1-1/resolve/main/control_v11p_sd15_canny.pth" "$EXT_DIR/sd-webui-controlnet/models/control_v11p_sd15_canny.pth" || true
download_file_with_retries "https://huggingface.co/lllyasviel/ControlNet-v1-1/resolve/main/control_v11p_sd15_openpose.pth" "$EXT_DIR/sd-webui-controlnet/models/control_v11p_sd15_openpose.pth" || true

# 3. VAE (To Workspace)
mkdir -p "$STORAGE_DIR/models/VAE"
download_file_with_retries "https://huggingface.co/stabilityai/sdxl-vae/resolve/main/sdxl_vae.safetensors" "$STORAGE_DIR/models/VAE/sdxl_vae.safetensors" || true

# 4. Base Models
ensure_civitai_asset_installed 1166878 "$MODEL_DIR" 

# 5. LoRAs
ensure_civitai_asset_installed 1074877 "$LORA_DIR" 
ensure_civitai_asset_installed 1486082 "$LORA_DIR" 
ensure_civitai_asset_installed 1360425 "$LORA_DIR" 
ensure_civitai_asset_installed 1470544 "$LORA_DIR" 
ensure_civitai_asset_installed 1674551 "$LORA_DIR" 
ensure_civitai_asset_installed 999582 "$LORA_DIR" 
ensure_civitai_asset_installed 1458421 "$LORA_DIR" 
ensure_civitai_asset_installed 960678 "$LORA_DIR" 

echo "Provisioning completed successfully!"
